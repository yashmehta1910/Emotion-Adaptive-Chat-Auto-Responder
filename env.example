# Copy this file to ".env" (same folder) and fill in your values.
# Never share your real .env file.

# --- Gemini (the AI that judges emotion and writes replies) ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_NAME=gemini-3.5-flash-lite
# Minimum seconds between AI calls (protects the free-tier per-minute limit).
GEMINI_MIN_INTERVAL_SECONDS=5

# Offline demo with NO API key (simple keyword rules, not real AI):
# LLM_BACKEND=stub

# --- Where the bot runs by default (you can change it in the dashboard) ---
#   mock     = built-in demo chat
#   whatsapp = WhatsApp Web in a browser window the bot controls
DRIVER=mock

# --- Browser used for WhatsApp Web (optional) ---
# By default Playwright's own Chromium is used (run: python -m playwright install chromium).
# To use an installed browser instead, set ONE of these:
# BROWSER_CHANNEL=chrome
# BROWSER_EXECUTABLE_PATH=C:\Program Files\BraveSoftware\Brave-Browser\Application\brave.exe
HEADLESS=false

# --- Dashboard address ---
HOST=127.0.0.1
PORT=8000
